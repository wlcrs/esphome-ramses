# ==============================================================================
# ESPHome Secrets Template
# ==============================================================================
# To use this, copy this file to `secrets.yaml`:
#   cp secrets.yaml.example secrets.yaml
#
# Then fill in your local Wi-Fi credentials below.
# (secrets.yaml is ignored by git so your passwords will not be committed)
# ==============================================================================

wifi_ssid: "MyWiFiNetwork"
wifi_password: "MyWiFiPassword"
wifi_ap_password: "fallbackpassword"

# Optional MQTT credentials if using example-c6-mqtt.yaml:
# mqtt_broker: "192.168.1.50"
# mqtt_username: "ramses_user"
# mqtt_password: "ramses_password"
